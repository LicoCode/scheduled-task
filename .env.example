# 未写出或留空的项都会自动使用程序内默认值，不必全部填写。
# dry-run 可不配邮件；正式发信至少需要 EMAIL_SENDER + EMAIL_PASSWORD。

# ========== 邮件（发信时需要）==========
EMAIL_SENDER=
EMAIL_PASSWORD=
# 可不填：默认发给 EMAIL_SENDER
# EMAIL_RECEIVERS=
# EMAIL_SENDER_NAME=每日资讯助手
# 一般不用配：会按发件箱自动推断（QQ / 163 / Gmail）
# SMTP_HOST=
# SMTP_PORT=

# ========== LLM（要用翻译/精排/解读时必须三项都配）==========
# 兼容 OpenAI Chat Completions；不配则相关能力降级，无内置默认模型
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ========== 业务参数（均可省略）==========
# GITHUB_LANGUAGES=
# GITHUB_TRENDING_LIMIT=15
# ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL,cs.CV,cs.RO,cs.NE,stat.ML
# ARXIV_MAX_PAPERS=10
# ARXIV_CANDIDATE_POOL=25
# ARXIV_TOPIC_KEYWORDS=
