# ========== 邮件（必填）==========
EMAIL_SENDER=your_email@qq.com
EMAIL_PASSWORD=your_smtp_auth_code
EMAIL_RECEIVERS=receiver1@example.com,receiver2@example.com
EMAIL_SENDER_NAME=每日资讯助手
# QQ 邮箱可用 smtp.qq.com:465；Gmail 用 smtp.gmail.com:465
SMTP_HOST=smtp.qq.com
SMTP_PORT=465

# ========== LLM（突破性排序与效果解读推荐配置）==========
# 兼容 OpenAI 接口的任意服务（DeepSeek / 通义 / OpenAI 等）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ========== 业务参数（可选）==========
# GitHub 热榜语言过滤，留空表示全语言；多个用逗号分隔，如 python,typescript
GITHUB_LANGUAGES=
GITHUB_TRENDING_LIMIT=15

# arXiv：主题粗筛 + LLM 按突破性/效果精排
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL,cs.CV,cs.NE,stat.ML
ARXIV_MAX_PAPERS=10
ARXIV_CANDIDATE_POOL=25
# 留空使用内置主题词（世界模型/Agent/大模型/社会智能等）
ARXIV_TOPIC_KEYWORDS=
